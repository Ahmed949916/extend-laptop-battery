<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings live in Directory.Build.props / Directory.Packages.props at the root. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SelfTest</AssemblyName>
    <DebugType>none</DebugType>

    <!--
      The app is a WinExe, so consuming its types means enabling WinForms here too. This
      used to be a hand-picked <Compile Include> list of the app's own source files, which
      silently went stale every time the app gained a file - adding Json.cs broke it, and
      the error pointed at the app rather than at the list that had forgotten it.
    -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerDial\PowerDial.csproj" />
  </ItemGroup>

</Project>
