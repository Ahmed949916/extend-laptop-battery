<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SelfTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1051;CA1305;CA1707;CA1507;CA1805;CA1720</NoWarn>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\PowerDial\PowerCfg.cs" />
    <Compile Include="..\PowerDial\Machine.cs" />
    <Compile Include="..\PowerDial\Config.cs" />
    <Compile Include="..\PowerDial\Battery.cs" />
    <Compile Include="..\PowerDial\GpuWatch.cs" />
    <Compile Include="..\PowerDial\ProcessWatch.cs" />
    <Compile Include="..\PowerDial\Advisor.cs" />
    <Compile Include="..\PowerDial\Presets.cs" />
    <Compile Include="SelfTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
</Project>
