# Build output. None of it belongs in the repo - it is regenerated by scripts\publish.ps1
# on any machine with the .NET SDK.
#
# These patterns were here before, but bin/ and obj/ had already been committed, and git
# keeps tracking a file it is already tracking however well .gitignore matches it. They
# were removed from the index with `git rm -r --cached`, so the rules now do their job.
bin/
obj/

# The runnable copy at the repo root IS committed on purpose - PowerDial.exe is how the
# app is handed to someone who will not build it. It is a single-file publish, so it
# needs nothing beside it; the loose PowerDial.dll, .deps.json, .runtimeconfig.json,
# System.Management.dll and runtimes\ that used to sit here were left over from an older
# multi-file layout and are ignored in case a stray publish puts them back.
/PowerDial.dll
/PowerDial.deps.json
/PowerDial.runtimeconfig.json
/System.Management.dll
/runtimes/
/*.exe
# Where scripts\publish.ps1 stages the published files before copying the one exe up.
/.publish/

# Files moved aside for the user to delete.
_to_delete/

# Local scratch
*.user
